<?xml version="1.0" encoding="UTF-8"?>
<!-- Test-only logging config. logback-classic is on the test classpath solely so log-assertion
     tests can capture events with a ListAppender; keep the noisy INFO chatter of
     Flyway/Testcontainers/HikariCP out of the build log. A logger under test must pass WARN for
     the capture to see its events.

     The root stays at WARN, not ERROR: this module's suite is mostly Testcontainers integration
     tests, and an ERROR root silences every WARN in it — including the warnings a failing test's
     own subsystem emits on the way down, which is exactly the diagnostic an unrelated CI failure
     depends on. WARN is quiet enough for the noise this file exists to suppress. -->
<configuration>
  <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%d{HH:mm:ss.SSS} %-5level %logger{36} - %msg%n</pattern>
    </encoder>
  </appender>

  <logger name="org.streamrune.postgres.PostgresEventStoreFactory" level="WARN"/>

  <root level="WARN">
    <appender-ref ref="CONSOLE"/>
  </root>
</configuration>
